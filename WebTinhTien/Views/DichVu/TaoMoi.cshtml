@model WebTinhTien.Models.DichVuModel
@{
    ViewBag.Title = "Thêm dịch vụ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <h1>Thêm dịch vụ</h1>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">Thông tin dịch vụ</h3>
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Ma, "Mã")
                            @Html.TextBoxFor(m => m.Ma, new { @class = "form-control", @required = "required", placeholder = "Nhập mã dịch vụ" })
                            @Html.ValidationMessageFor(m => m.Ma, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.Ten, "Tên")
                            @Html.TextBoxFor(m => m.Ten, new { @class = "form-control", @required = "required", placeholder = "Nhập tên dịch vụ" })
                            @Html.ValidationMessageFor(m => m.Ten, "", new { @class = "text-danger" })
                        </div>
                        <h4>Nguyên liệu sử dụng</h4>
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>STT</th>
                                    <th>Mã nguyên liệu</th>
                                    <th>Tên nguyên liệu</th>
                                    <th>Số lượng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.DanhSachNguyenLieu.Count; i++)
                                {
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td>@Model.DanhSachNguyenLieu[i].Ma</td>
                                        <td>@Model.DanhSachNguyenLieu[i].Ten</td>
                                        <td>
                                            @Html.HiddenFor(m => m.DanhSachNguyenLieu[i].Id)
                                            @Html.TextBoxFor(m => m.DanhSachNguyenLieu[i].SoLuong, new {
                                                @class = "form-control",
                                                type = "number",
                                                //step = "0.01",
                                                min = "0"
                                            })
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer">
                        <button type="submit" class="btn btn-success"><i class="fas fa-save"></i> Lưu</button>
                        <a href="@Url.Action("DanhSach")" class="btn btn-secondary">Hủy</a>
                    </div>
                </div>
            }
        </div>
    </section>
</div>