@model CoreWebTinhTien.Domain.NguoiDung

    @{
        ViewBag.Title = "Sửa người dùng";
        Layout = "~/Views/Shared/_Layout.cshtml";
    }

    <div class="content-wrapper">
        <section class="content-header">
            <div class="container-fluid">
                <h1>Sửa người dùng</h1>
            </div>
        </section>
        <section class="content">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">
                    <hr />
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="form-group">
                        @Html.LabelFor(m => m.TenDangNhap, "Tên đăng nhập", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-12">
                            @Html.TextBoxFor(m => m.TenDangNhap, new { @class = "form-control"  ,@readonly = "true" })
                            @Html.ValidationMessageFor(m => m.TenDangNhap, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.MatKhau, "Mật khẩu", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-12">
                            @Html.PasswordFor(m => m.MatKhau, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.MatKhau, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-offset-2 col-md-12">
                            <input type="submit" value="Lưu" class="btn btn-primary" />
                            @Html.ActionLink("Quay lại", "DanhSach", null, new { @class = "btn btn-default" })
                        </div>
                    </div>
                </div>
            }
        </section>
    </div>
    @section Scripts {
        @Scripts.Render("~/bundles/jqueryval")

        
    }
